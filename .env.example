# Copia este archivo como .env (el .env NO se sube a git). Lo usa docker-compose.
# Solo datos públicos de Supabase. NUNCA la secret key ni la contraseña de la BD.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Solo proyectos antiguos con HS256; los nuevos verifican con JWKS (dejar vacío)
SUPABASE_JWT_SECRET=

# API (NestJS)
API_URL=http://localhost:3000/api
CORS_ORIGINS=http://localhost:8080
SWAGGER_ENABLED=true

# Web (Angular)
APP_ENTORNO=dev
# Licencia de PrimeUI (PrimeNG 22+): sin ella aparece el aviso "Invalid PrimeUI License"
PRIME_LICENSE=

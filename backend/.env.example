# Copia como backend/.env para correr el backend en tu PC (npm run start:dev).
# El .env NO se sube a git.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Supabase: SOLO la URL y la publishable key. Nunca la secret key.
# Local (npx supabase start): http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Solo si el proyecto todavía firma con HS256 (legacy JWT secret). Los nuevos usan JWKS: dejar vacío.
# SUPABASE_JWT_SECRET=

CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Copia como backend/.env para correr el backend en tu PC (npm run start:dev).
# El .env NO se sube a git.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Supabase: SOLO la URL y la publishable key (es pública, la misma de frontend/public/config.json).
# NUNCA la secret key.
# Proyecto COLDWORK en la nube:
SUPABASE_URL=https://xlkajikflheljiozbwej.supabase.co
SUPABASE_KEY=sb_publishable_bXH6c2gnu7fF-pwwX_1Y-Q_ohK-81m3
# Base local (npx supabase start): SUPABASE_URL=http://127.0.0.1:54321 y la publishable key que muestre.
# Solo si el proyecto todavía firma con HS256 (legacy JWT secret). Los nuevos usan JWKS: dejar vacío.
# SUPABASE_JWT_SECRET=

CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
